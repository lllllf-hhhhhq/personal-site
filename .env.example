# 复制为 .env.local（本地）或在部署平台填入同名变量（线上）

# 必填：后台登录口令
ADMIN_PASSWORD=

# 必填：会话 Cookie 的 HMAC 签名密钥，长度不少于 16 位
SESSION_SECRET=

# 线上持久化必填：内容写回仓库所需
# GITHUB_TOKEN 需具备该仓库 Contents 的读写权限（细粒度令牌：Contents → Read and write）
GITHUB_TOKEN=
# 格式为 owner/repo，例如 wangluefan/personal-site
GITHUB_REPO=
GITHUB_BRANCH=main
